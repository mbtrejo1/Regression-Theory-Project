traffic <- read.csv(
"C:/Users/Bruno/Downloads/Traffic_Crashes_Resulting_in_Injury_20260917.csv"
)
library(dplyr)
library(lubridate)
library(ggplot2)
hour_value <- hour(hms(traffic$collision_time))
night_percent_per_year <- traffic |>
mutate(hour = hour(hms(collision_time))) |>
group_by(accident_year) |>
summarise(
total_crashes = n(),
night_crashes = sum(hour >= 21 | hour < 6, na.rm = TRUE),
night_percent = 100 * night_crashes / total_crashes
)
ggplot(night_percent_per_year,
aes(x = year, y = night_percent)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
xlab("Year") +
ylab("Percent of crashes from 9 PM to 6 AM") +
ggtitle("Nighttime Crashes by Year")
